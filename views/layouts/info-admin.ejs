<!DOCTYPE html>
<html lang="ro">
<head>
  <meta charset="UTF-8">
  <meta name="color-scheme" content="light">
  <meta name="supported-color-schemes" content="light">
  <title>Mesaj</title>
</head>

<body style="
  margin:0;
  padding:12px;
  background:#ffffff;
  font-family:Courier, monospace;
">

  <!-- CONTAINER -->
  <div style="
    max-width:600px;
    margin:0 auto;
    text-align:center;
  ">

    <!-- TITLU -->
    <h1 style="
      font-size:20px;
      margin:24px 0 16px;
      font-weight:bold;
    ">
      <%= data.name %>
    </h1>

    <!-- MESAJ -->
    <div style="
      font-size:14px;
      line-height:1.5;
      margin:0 0 16px;
    ">
      <%- data.prompt %>
    </div>

    <!-- ACTIUNE -->
    <div style="
      font-size:14px;
      line-height:1.5;
      margin:0 0 24px;
      font-weight:bold;
    ">
      <%- data.action %>
    </div>

  </div>

</body>
</html>
