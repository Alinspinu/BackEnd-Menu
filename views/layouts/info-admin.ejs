
<!DOCTYPE html>
<html>
<head>
  <style>
    body {
      padding-right: 8px;
    }
    .container {
      border-radius: 12px;
      height: fit-content;
      width: fit-content;
      padding: 14px;
      margin-right: 8px;
      background-color: #c1ebfe;
    }
    h1{

        font-size: 1.2rem;
    }
    .text{

      font-size: 16px;
      letter-spacing: 1.4;
      line-height: 1.2;
      padding-top: 12px;
      margin-top: 14px;
      margin-bottom: 14px;
    }


  </style>
</head>
<body>
  <div class="container">
    <h1><%=data.name%></h1>
    <span class="text"><%-data.prompt%></span>
    <span class="text"><%-data.action%></span>
  </div>

</body>
</html>