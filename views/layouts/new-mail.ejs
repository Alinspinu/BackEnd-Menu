<!DOCTYPE html>
<html lang="ro">
<head>
  <meta charset="UTF-8">
  <title>Confirmare comandă</title>
</head>

<body style="margin:0; padding:8px; background:#ffffff; font-family:Courier, monospace;">

  <!-- LOGO -->
  <div style="text-align:center; margin-top:12px;">
    <img src="<%= url %>"
         alt="logo"
         style="width:120px; height:120px; display:block; margin:0 auto 16px;">
  </div>

  <!-- TITLU -->
  <h1 style="text-align:center; text-transform:uppercase; font-size:22px; margin:0 0 12px;">
    Salut <%= data.clientInfo.name %>,
  </h1>

  <h2 style="text-align:center; font-size:22px; margin:0 0 12px;">
    Îți mulțumim că ai ales <%= data.locatie.name %>!
  </h2>

  <p style="text-align:center; font-size:14px; margin:0 0 24px;">
    Comanda ta a fost confirmată și este în curs de pregătire.<br>
    Detaliile comenzii tale sunt următoarele:
  </p>

  <!-- BON -->
  <div style="border:1px solid #000; max-width:600px; margin:0 auto;">

    <!-- HEADER -->
    <div style="background:#000; color:#fff; padding:12px 0; display:flex;">
      <div style="width:60%; padding-left:10%; text-transform:uppercase;">
        Produs
      </div>
      <div style="width:30%; text-transform:uppercase;">
        Preț
      </div>
    </div>

    <!-- PRODUSE -->
    <% data.products.forEach(function(p){ %>
      <div style="display:flex; padding:6px 0;">
        <div style="width:60%; padding-left:10%;">
          <%= p.quantity %> x <%= p.name %>
        </div>
        <div style="width:30%;">
          <%= p.total %> Lei
        </div>
      </div>
    <% }) %>

    <!-- TOTAL -->
    <div style="display:flex; padding:12px 0; border-top:1px solid #000;">
      <% if (data.payOnSite) { %>
        <div style="width:60%; padding-left:10%; text-transform:uppercase;">
          Total de plată
        </div>
      <% } else { %>
        <div style="width:60%; padding-left:10%; text-transform:uppercase;">
          Total
        </div>
      <% } %>
      <div style="width:30%;">
        <%= data.totalProducts %> Lei
      </div>
    </div>

    <!-- CASHBACK -->
    <% if (data.cashBack > 0) { %>
      <div style="display:flex; padding:12px 0; border-top:1px solid #000;">
        <div style="width:60%; padding-left:10%;">
          Plătit cu CashBack
        </div>
        <div style="width:30%;">
          <%= data.cashBack %> Lei
        </div>
      </div>

      <% if (!data.payOnLine) { %>
        <div style="display:flex; padding:12px 0; border-top:1px solid #000;">
          <div style="width:60%; padding-left:10%;">
            Rest de plată
          </div>
          <div style="width:30%;">
            <%= data.total %> Lei
          </div>
        </div>
      <% } %>
    <% } %>

    <!-- ONLINE -->
    <% if (data.payOnLine) { %>
      <div style="display:flex; padding:12px 0; border-top:1px solid #000;">
        <div style="width:60%; padding-left:10%;">
          Plătit online
        </div>
        <div style="width:30%;">
          <%= data.total %> Lei
        </div>
      </div>
    <% } %>

  </div>

  <!-- INFO -->
  <div style="text-align:center; margin-top:24px; font-size:14px;">
    <div style="margin-bottom:12px;">
      Adresă locație: <%= data.salePoint.address %>
    </div>
    <div style="margin-bottom:12px;">
      Timp estimat de ridicare: <%= data.completetime / 1000 / 60 %> minute
    </div>
    <div>
      Te așteptăm cu drag să vii să îți ridici comanda!
    </div>
  </div>

</body>
</html>
