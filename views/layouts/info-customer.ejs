<!DOCTYPE html>
<html lang="ro">
<head>
  <meta charset="UTF-8">
  <meta name="color-scheme" content="light">
  <meta name="supported-color-schemes" content="light">
  <title>Comandă</title>
</head>

<body style="
  margin:0;
  padding:16px;
  background-color:#f6e7d3;
  font-family: Courier, monospace;
  color:#2a2929;
">

  <!-- OUTER CONTAINER -->
  <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#f6e7d3;">
    <tr>
      <td align="center">

        <!-- HEADER -->
        <table width="100%" cellpadding="0" cellspacing="0" style="
          max-width:600px;
          background-color:#dec5a3;
          padding:24px;
          margin-bottom:16px;
        ">
          <tr>
            <td align="center">
              <h1 style="margin:0; font-weight:600;">
                Salut <%= data.clientInfo.name %>!
              </h1>
              <hr style="border:none; border-top:1px solid #bfa27a; margin:12px 0;">
              <h2 style="margin:0; font-weight:500;">
                Mulțumim frumos pentru comandă!
              </h2>
            </td>
          </tr>
        </table>

        <!-- ORDER CARD -->
        <table width="100%" cellpadding="0" cellspacing="0" style="
          max-width:420px;
          background-color:#dec5a3;
        ">
          
          <!-- HEADER -->
          <tr>
            <td style="
              padding:12px;
              font-weight:600;
              border-bottom:1px solid #bfa27a;
            ">
              Nr. <%= data.index %>
              <span style="float:right;">
                <%= data.clientInfo.name %>
              </span>
            </td>
          </tr>

          <!-- PRODUCTS -->
          <% for (let i = 0; i < data.products.length; i++) { %>
          <tr>
            <td style="padding:10px 12px;">
              <strong><%= data.products[i].quantity %></strong> x
              <%= data.products[i].name %>
              <span style="float:right; font-weight:600;">
                <%= data.products[i].total %> Lei
              </span>
            </td>
          </tr>
          <% } %>

          <!-- TOTALS -->
          <% if (data.payOnSite) { %>
          <tr>
            <td style="padding:10px 12px;">
              Total de plată:
              <span style="float:right; font-weight:600;">
                <%= data.totalProducts %> Lei
              </span>
            </td>
          </tr>
          <% } else { %>
          <tr>
            <td style="padding:10px 12px;">
              Total produse:
              <span style="float:right; font-weight:600;">
                <%= data.totalProducts %> Lei
              </span>
            </td>
          </tr>
          <% } %>

          <!-- CASHBACK -->
          <% if (data.cashBack > 0) { %>
          <tr>
            <td style="padding:10px 12px;">
              Plătit cu CashBack:
              <span style="float:right; font-weight:600;">
                <%= data.cashBack %> Lei
              </span>
            </td>
          </tr>

          <% if (!data.payOnLine) { %>
          <tr>
            <td style="padding:10px 12px;">
              Rest de plată:
              <span style="float:right; font-weight:600;">
                <%= data.total %> Lei
              </span>
            </td>
          </tr>
          <% } %>
          <% } %>

          <!-- ONLINE PAYMENT -->
          <% if (data.payOnLine) { %>
          <tr>
            <td style="padding:10px 12px; font-weight:600;">
              Plătit online: <%= data.total %> Lei
            </td>
          </tr>
          <% } %>

          <!-- TIME -->
          <tr>
            <td style="padding:12px;">
              <% if (data.preOrder) { %>
                Comanda ta va fi gata în <%= data.preOrderPickUpDate %>.
              <% } else if (data.completetime === 0) { %>
                Comanda ta va fi gata în cel mai scurt timp!
              <% } else { %>
                Comanda ta va fi gata în <%= data.completetime / 1000 / 60 %> minute!
              <% } %>
            </td>
          </tr>

          <!-- FOOTER -->
          <tr>
            <td style="padding:12px; font-weight:600;">
              Cu drag, echipa <%= data.locatie.name %>!
            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>

</body>
</html>
