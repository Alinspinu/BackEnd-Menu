


<!DOCTYPE html>
<html>
  <body style="
    margin:0;
    padding:12px;
    font-family: Courier, Arial, Helvetica, sans-serif;
    background-color:#ffffff;
    color:#000000;
  ">

    <table width="100%" cellpadding="0" cellspacing="0">
      <tr>
        <td align="center">

          <!-- LOGO -->
          <img
            src="<%= logoUrl %>"
            alt="logo"
            width="120"
            style="display:block; margin:16px auto;"
          />

          <!-- GREETING -->
          <h1 style="
            margin:16px 0;
            font-size:22px;
            text-transform:uppercase;
          ">
            Salut, <%= reservation.client.name %>!
          </h1>

          <!-- STATUS -->
          <p style="font-size:16px; margin-bottom:20px;">
            Rezervarea cu numărul
            <strong><%= reservation.index %></strong>
            a fost
            <strong>
              <%= reservation.status === 'canceled'
                ? 'anulată'
                : 'acceptată'
              %>
            </strong>.
          </p>

          <!-- DETAILS TITLE -->
          <h3 style="margin:16px 0;">Detaliile rezervării</h3>

          <!-- DETAILS TABLE -->
          <table
            width="100%"
            cellpadding="6"
            cellspacing="0"
            border="1"
            style="
              border-collapse:collapse;
              max-width:520px;
              margin:0 auto 20px auto;
              font-size:14px;
            "
          >
            <tr>
              <td>Nume</td>
              <td><strong><%= reservation.client.name %></strong></td>
            </tr>

            <tr>
              <td>Ziua</td>
              <td><strong><%= reservation.dateString %></strong></td>
            </tr>

            <tr>
              <td>Sosire</td>
              <td><strong><%= reservation.start %></strong></td>
            </tr>

            <tr>
              <td>Plecare</td>
              <td><strong><%= reservation.end %></strong></td>
            </tr>

            <tr>
              <td>Ședere</td>
              <td><strong><%= reservation.period %> ore</strong></td>
            </tr>

            <% if (reservation.kids > 0) { %>
              <tr>
                <td>Adulți</td>
                <td><strong><%= reservation.guests %></strong></td>
              </tr>
              <tr>
                <td>Copii</td>
                <td><strong><%= reservation.kids %></strong></td>
              </tr>
            <% } else { %>
              <tr>
                <td>Invitați</td>
                <td><strong><%= reservation.guests %></strong></td>
              </tr>
            <% } %>

            <tr>
              <td>Detalii</td>
              <td><strong><%= reservation.details || '-' %></strong></td>
            </tr>
          </table>
          <%if(reservation.status === 'canceled'){%>
            <p style="font-size:14px; margin-top:16px;">
              <strong><%= reservation.salePoint.name %></strong>,<br/>
              <em><%= reservation.salePoint.address %></em>
            </p>

            <p style="margin-top:12px;">
              Vă așteptăm cu drag!
            </p>

          <%}else { %>
            <%if(reservation.salePoint.name === 'Dune Cotroceni'){%>
              <h3 style="margin-top:12px;">
                Regulamentul Dune Cotroceni
              </h3>
    
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:12px;">
                <tr>
                  <td align="center" style="padding:0; margin:0;">
                    <img
                      src="https://res.cloudinary.com/dg7eza79w/image/upload/v1771504368/WhatsApp_Image_2026-02-19_at_14.19.53_wqxzok.jpg"
                      alt="imagine_regulament"
                      width="520"
                      style="display:block; width:100%; max-width:520px; height:auto; border:0; margin:0 auto;"
                    />
                  </td>
                </tr>
              </table>
              <%}%>
          <!-- LOCATION -->
          <p style="font-size:14px; margin-top:16px;">
            Ne găsești la
            <strong><%= reservation.salePoint.name %></strong>,<br/>
            <em><%= reservation.salePoint.address %></em>
          </p>

          <p style="margin-top: 2px;">
           <em> *Pentru informații de orientare sau dacă doriti să modificați datele rezervării va rugăm să ne contactați la</em>  <strong><%=reservation.salePoint.telephone%></strong>
          </p>

           <a style="font-size:14px; margin-top:16px;" href="<%=cancelUrl%>"><strong>Anulează Rezervarea</strong></a>  

          <p style="margin-top:12px;">
            Vă așteptăm cu drag!
          </p>
          <%}%>
        </td>
      </tr>
    </table>

  </body>
</html>