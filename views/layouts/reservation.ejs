
<!DOCTYPE html>
<html>
  <head>
  <style>
    @font-face {
  font-family: 'NoirProRegular'; 
  src: url('../../public/font/NoirPro-Regular.woff') format('truetype'); 
}
    @font-face {
  font-family: 'NoirProMed'; 
  src: url('../../public/font/NoirPro-Medium.woff') format('truetype'); 
}

body{
        padding: 8px !important;
       
    }
    h1, h2, .code, h5{
      font-family: NoirProMed, Courier !important;
    }

    p, .address, tbody, h5{
      font-family: NoirProRegular, Courier !important;
    }
    .address{
      font-style: italic;
    }
    h1{
        text-transform: uppercase;
    }
    h2{
      font-size: 22px !important;
    }
    .img{
        height: 120px;
        width: 120px;
    }
    .img-container{
        margin-top: 12px;
    }
    .code{
      font-size: 46px;
      font-weight: bold;
      letter-spacing: 6px;
    }
  </style>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>Info Reservation</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
</head>
<body>
  <div class="container-fluid vh-100 cont">
    <div class="text-center img-container col-lg-6 offset-lg-3">
       <img src="<%=logoUrl%>" alt="logo-image" class="img mb-4">
       <h1 class="mb-4">salut, <%=reservation.client.name%>!</h1>
       <h2 class="mb-4">Rezervarea cu numarul <strong><%=reservation.index%></strong> a fost acceptată.</h2>
        <h5 class="mb-4">Detaliile rezervării</h5>
        <% if(reservation.locatie.name === 'Flowmanager') {%>
        <div class="table-responsive">
          <table class="table table-bordered">
            <tbody>
              <tr>
                <td class="p-1">Nume</td>
                <td><%=reservation.client.name%><td>
              </tr>
              <tr>
                <td class="p-1">Ziua</td>
                <td><%=reservation.dateString%></td>
              </tr>
              <tr>
                <td class="p-1">Ora de sosire</td>
                <td><%=reservation.start%></td>
              </tr>
              <tr>
                <td class="p-1">Ora de plecare</td>
                <td><%=reservation.end%></td>
              </tr>
              <tr>
                <td class="p-1">Perioada de ședere</td>
                <td><%=reservation.period%></td>
              </tr>
              <% if(reservation.kids > 0) {%>
              <tr>
                <td class="p-1">Invitați Adulți</td>
                <td><%=reservation.guests%></td>
              </tr>
              <tr>
                <td class="p-1">Invitați Copii</td>
                <td><%=reservation.kids%></td>
              </tr>
              <%} else {%>
                <tr>
                  <td class="p-1">Invitați</td>
                  <td><%=reservation.guests%></td>
                </tr>
                <%}%>
                <tr>
                  <td class="p-1">Detalii</td>
                  <td><%=reservation.details || '-'%></td>
                </tr>
            </tbody>
          </table>
        </div>
        <%}%>
       <p>Ne găsești la <%=reservation.salePoint.name%>, pe <%=reservation.salePoint.address%>. <br> Te așteptăm cu drag!</p>

    </div>

</div>

</body>
</html>