<!DOCTYPE html>
<html lang="ro">
<head>
  <meta charset="UTF-8">
  <meta name="color-scheme" content="light">
  <meta name="supported-color-schemes" content="light">
  <title>Finalizează înregistrarea</title>
</head>

<body style="
  margin:0;
  padding:12px;
  background:#ffffff;
  font-family:Courier, monospace;
">

  <!-- CONTAINER -->
  <div style="
    max-width:600px;
    margin:0 auto;
    text-align:center;
  ">

    <!-- LOGO -->
    <div style="margin-top:12px;">
      <img src="<%= logoUrl %>"
           alt="logo"
           style="
             width:120px;
             height:120px;
             display:block;
             margin:0 auto 16px;
           ">
    </div>

    <!-- TITLU -->
    <h1 style="
      font-size:22px;
      text-transform:uppercase;
      margin:24px 0 16px;
      font-weight:bold;
    ">
      Salut <%= name %>!
    </h1>

    <h2 style="
      font-size:18px;
      margin:0 0 24px;
      font-weight:bold;
    ">
      Bine ai venit la <%= locatie %>, ne bucurăm că ne ești alături!
    </h2>

    <!-- MESAJ -->
    <p style="
      font-size:14px;
      margin:0 0 16px;
      line-height:1.5;
    ">
      <%= message %>
    </p>

    <p style="
      font-size:12px;
      margin:0 0 24px;
      font-style:italic;
    ">
      * Dacă nu știi despre ce este vorba, ignoră acest e-mail.
    </p>

    <p style="
      font-size:14px;
      margin:0 0 24px;
    ">
      Te rugăm să-ți finalizezi înregistrarea apăsând butonul de mai jos.
    </p>

    <!-- BUTON -->
    <div style="margin-bottom:32px;">
      <a href="<%= link %>"
         style="
           display:inline-block;
           background:#000;
           color:#fff;
           padding:12px 20px;
           text-decoration:none;
           font-size:14px;
           font-weight:bold;
           border-radius:2px;
         ">
        FINALIZEAZĂ ÎNREGISTRAREA
      </a>
    </div>

  </div>

</body>
</html>
